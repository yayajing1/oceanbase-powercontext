# 复制为 .env 后按实际环境填写。**不要提交真实凭据。**
# 模块只读取环境变量，不自动读取 .env；请用 `set -a; . ./.env; set +a` 或
# 在你的 shell / CI 中导出同名变量。

# ---------------------------------------------------------------- 数据库
# seekdb 或 OceanBase（MySQL 协议，默认端口 2881）
SDD_DB_HOST=127.0.0.1
SDD_DB_PORT=2881
SDD_DB_USER=root
SDD_DB_PASSWORD=
SDD_DB_NAME=sdd_context

# ---------------------------------------------------------------- 业务工程
# 默认为 <仓库>/minimax/demo_project
SDD_PROJECT_ROOT=

# ---------------------------------------------------------------- PowerContext
# 任务状态库（SQLite 文件），重启后仍可读回
SDD_STATE_DB=
SDD_SCHEDULER_DB=
# 同一个幂等键对应同一个 Scope，便于多次运行复用同一份状态
SDD_SCOPE_KEY=sdd-context
SDD_SCOPE_TITLE=SDD context (MiniMax x OceanBase)

# ---------------------------------------------------------------- MiniMax
# 在 MiniMax 开放平台申请 API Key（形如 sk-...）
MINIMAX_API_KEY=
# Anthropic 兼容端点；使用官方 API Key 时保持默认即可
MINIMAX_BASE_URL=https://api.minimaxi.com/anthropic
# 按账号实际可用的模型填写，例如 MiniMax-M3 / MiniMax-M2.5
MINIMAX_MODEL=MiniMax-M3
MINIMAX_MAX_TOKENS=32768
MINIMAX_THINKING=adaptive
MINIMAX_TIMEOUT=300
