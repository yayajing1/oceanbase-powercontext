# 复制为 qoder/.env 后按本机环境修改；.env 已在 .gitignore 中，不要提交真实凭据。
# 进程环境变量优先于本文件，因此也可以直接 export 同名变量。

# ---------------------------------------------------------------- seekdb / OceanBase
# MySQL 协议端口；seekdb 默认 2882（OceanBase 单机默认 2881）
PAPERDESK_DB_HOST=127.0.0.1
PAPERDESK_DB_PORT=2882
PAPERDESK_DB_USER=root
# 本机默认空密码；如设置了密码，填在这里或导出同名环境变量
PAPERDESK_DB_PASSWORD=
# 库不存在时 init-db 会尝试创建
PAPERDESK_DB_NAME=paperdesk
PAPERDESK_DB_CONNECT_TIMEOUT=10

# ---------------------------------------------------------------- 文档导入
# 单块字符上限
PAPERDESK_MAX_CHARS=800

# 可选：指定另一个 .env 文件路径
# PAPERDESK_ENV_FILE=/absolute/path/to/paperdesk.env
